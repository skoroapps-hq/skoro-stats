// skorostats.com: one static page. Deployed from website/ with `npx wrangler deploy`.
{
  "name": "skorostats-site",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "skorostats.com", "custom_domain": true },
    { "pattern": "www.skorostats.com", "custom_domain": true }
  ]
}
